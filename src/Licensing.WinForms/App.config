<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 本机授权服务。改成你的服务器地址即可。 -->
    <add key="LicenseServer" value="http://localhost:5277" />
    <!-- 必须和后台产品标识逐字相同。演示数据是 demo.product，你的产品是 金石眼镜软件。 -->
    <add key="ProductId" value="demo.product" />
    <!-- 留空时会向上查找 src/Licensing.Server/storage/public-keys.json。 -->
    <add key="PublicKeyFile" value="" />
    <!-- 版本和功能的显示名，写成 代码=中文名，多项用分号隔开。对不上的代码会原样显示。 -->
    <add key="EditionNames" value="pro=专业版" />
    <add key="FeatureNames" value="export=导出" />
  </appSettings>
</configuration>
